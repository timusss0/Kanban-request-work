# Copy to .env for local use, and enter the same values in Vercel > Settings > Environment Variables
DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=papan_request

# true for cloud MySQL (TiDB Cloud, Aiven, etc.). false for local/XAMPP MySQL
DB_SSL=true
# Optional: CA certificate (PEM format) if the provider requires it, e.g. Aiven
DB_SSL_CA=

# Access code so others can't modify the board. Share it only with the boss.
APP_PASSWORD=replace-with-a-secret-code
